registry=https://artifact-keeper-gusw1.sidp.reports.mn/npm/mnet-npm-public/

strict-ssl=true
loglevel=http
prefer-online=true

# t3code needs lifecycle scripts (prepare/effect-tsgo patch, electron, node-pty)
ignore-scripts=false

# Security: only install package versions published at least 7 days ago.
# Requires npm CLI >= 11.10.0; ignored on older npm.
min-release-age=7
